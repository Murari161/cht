CREATE MATERIALIZED VIEW cht.mv_newborn_danger_sign_follow_up
TABLESPACE ts_report
AS
SELECT
      doc ->> '_id'                                                AS uuid,
      doc ->> '_rev'                                               AS rev,
      doc ->> 'form'                                               AS form,
      to_timestamp(NULLIF(doc ->> 'reported_date','')::bigint / 1000.0) AS reported,
      doc ->> 'from'                                               AS submitter,
      doc ->> 'content_type'                                       AS top_content_type,
      to_timestamp(NULLIF(doc #>> '{form_version,time}','')::bigint / 1000.0) AS form_version_time,
      doc #>> '{form_version,sha256}'                              AS form_version_sha256,
      (doc -> 'hidden_fields')::text                               AS hidden_fields_json,
     doc #>> '{fields,inputs,source}'                                    AS source,
     doc #>> '{fields,inputs,source_id}'                                 AS source_id,
     doc #>> '{fields,inputs,t_place_name}'                              AS t_place_name,
     doc #>> '{fields,inputs,t_vht_name}'                                AS t_vht_name,
     doc #>> '{fields,inputs,t_vht_phone}'                               AS t_vht_phone,
     doc #>> '{fields,inputs,user,contact_id}'                           AS contact_id,
     doc #>> '{fields,inputs,user,facility_id}'                          AS facility_id,
     doc #>> '{fields,inputs,contact,_id}'                               AS _id,
     doc #>> '{fields,inputs,contact,name}'                              AS name,
     doc #>> '{fields,inputs,contact,date_of_birth}'                     AS date_of_birth,
     doc #>> '{fields,inputs,contact,sex}'                               AS sex,
     doc #>> '{fields,inputs,contact,parent,_id}'                        AS parent__id,
     doc #>> '{fields,inputs,contact,parent,name}'                       AS parent_name,
     doc #>> '{fields,inputs,contact,parent,parent,_id}'                 AS parent_parent__id,
     doc #>> '{fields,inputs,contact,parent,parent,name}'                AS parent_parent_name,
     doc #>> '{fields,inputs,contact,parent,parent,contact,_id}'         AS contact__id,
     doc #>> '{fields,inputs,contact,parent,parent,contact,name}'        AS contact_name,
     doc #>> '{fields,inputs,contact,parent,parent,contact,phone}'       AS phone,
     doc #>> '{fields,patient_age_in_years}'                             AS patient_age_in_years,
     doc #>> '{fields,patient_age_in_months}'                            AS patient_age_in_months,
     doc #>> '{fields,patient_age_in_days}'                              AS patient_age_in_days,
     doc #>> '{fields,patient_age_display}'                              AS patient_age_display,
     doc #>> '{fields,patient_id}'                                       AS patient_id,
     doc #>> '{fields,patient_name}'                                     AS patient_name,
     doc #>> '{fields,patient_gender}'                                   AS patient_gender,
     doc #>> '{fields,chw_name}'                                         AS chw_name,
     doc #>> '{fields,chw_phone}'                                        AS chw_phone,
     doc #>> '{fields,chw_village}'                                      AS chw_village,
     doc #>> '{fields,needs_signoff}'                                    AS needs_signoff,
     doc #>> '{fields,group_danger_sign_follow_up,taken_to_health_facility}'  AS taken_to_health_facility,
     doc #>> '{fields,group_danger_sign_follow_up,still_experiencing_danger_signs}'  AS still_experiencing_danger_signs,
     doc #>> '{fields,group_danger_sign_follow_up,breathing_difficulty}'  AS breathing_difficulty,
     doc #>> '{fields,group_danger_sign_follow_up,not_breastfeeding_Well}'  AS not_breastfeeding_well,
     doc #>> '{fields,group_danger_sign_follow_up,feels_hot_or_cold}'    AS feels_hot_or_cold,
     doc #>> '{fields,group_danger_sign_follow_up,less_active}'          AS less_active,
     doc #>> '{fields,group_danger_sign_follow_up,yellow_body}'          AS yellow_body,
     doc #>> '{fields,group_danger_sign_follow_up,has_danger_signs}'     AS has_danger_signs,
     doc #>> '{fields,additional_doc,type}'                              AS type,
     doc #>> '{fields,additional_doc,content_type}'                      AS content_type,
     doc #>> '{fields,additional_doc,form}'                              AS form_field,
     doc #>> '{fields,additional_doc,contact,_id}'                       AS additional_doc_contact__id,
     doc #>> '{fields,additional_doc,parent,_id}'                        AS additional_doc_parent__id,
     doc #>> '{fields,additional_doc,fields,inputs,source}'              AS inputs_source,
     doc #>> '{fields,additional_doc,fields,inputs,source_id}'           AS inputs_source_id,
     doc #>> '{fields,additional_doc,fields,inputs,contact,_id}'         AS inputs_contact__id,
     doc #>> '{fields,additional_doc,fields,inputs,contact,name}'        AS inputs_contact_name,
     doc #>> '{fields,additional_doc,fields,created_by_doc}'             AS created_by_doc,
     doc #>> '{fields,additional_doc,fields,client_id}'                  AS client_id,
     doc #>> '{fields,additional_doc,fields,client_uuid}'                AS client_uuid,
     doc #>> '{fields,additional_doc,fields,client_name}'                AS client_name,
     doc #>> '{fields,additional_doc,fields,place_id}'                   AS place_id,
     doc #>> '{fields,additional_doc,fields,place_name}'                 AS place_name,
     doc #>> '{fields,additional_doc,fields,vht_name}'                   AS vht_name,
     doc #>> '{fields,additional_doc,fields,vht_phone}'                  AS vht_phone,
     doc #>> '{fields,additional_doc,fields,follow_up_date}'             AS follow_up_date,
     doc #>> '{fields,additional_doc,fields,client_age_in_years}'        AS client_age_in_years,
     doc #>> '{fields,additional_doc,fields,client_age_in_months}'       AS client_age_in_months,
     doc #>> '{fields,additional_doc,fields,client_age_in_days}'         AS client_age_in_days,
     doc #>> '{fields,additional_doc,fields,client_age_display}'         AS client_age_display,
     doc #>> '{fields,additional_doc,fields,client_sex}'                 AS client_sex,
     doc #>> '{fields,additional_doc,fields,danger_signs,_breathing_difficulty}'  AS _breathing_difficulty,
     doc #>> '{fields,additional_doc,fields,danger_signs,_not_breastfeeding_Well}'  AS _not_breastfeeding_well,
     doc #>> '{fields,additional_doc,fields,danger_signs,_feels_hot_or_cold}'  AS _feels_hot_or_cold,
     doc #>> '{fields,additional_doc,fields,danger_signs,_less_active}'  AS _less_active,
     doc #>> '{fields,additional_doc,fields,danger_signs,_yellow_body}'  AS _yellow_body,
     doc #>> '{fields,additional_doc_follow_up,type}'                    AS additional_doc_follow_up_type,
     doc #>> '{fields,additional_doc_follow_up,content_type}'            AS additional_doc_follow_up_content_type,
     doc #>> '{fields,additional_doc_follow_up,form}'                    AS additional_doc_follow_up_form,
     doc #>> '{fields,additional_doc_follow_up,contact,_id}'             AS additional_doc_follow_up_contact__id,
     doc #>> '{fields,additional_doc_follow_up,parent,_id}'              AS additional_doc_follow_up_parent__id,
     doc #>> '{fields,additional_doc_follow_up,fields,inputs,source}'    AS fields_inputs_source,
     doc #>> '{fields,additional_doc_follow_up,fields,inputs,source_id}'  AS fields_inputs_source_id,
     doc #>> '{fields,additional_doc_follow_up,fields,inputs,contact,_id}'  AS fields_inputs_contact__id,
     doc #>> '{fields,additional_doc_follow_up,fields,inputs,contact,name}'  AS fields_inputs_contact_name,
     doc #>> '{fields,additional_doc_follow_up,fields,created_by_doc}'   AS fields_created_by_doc,
     doc #>> '{fields,additional_doc_follow_up,fields,client_id}'        AS fields_client_id,
     doc #>> '{fields,additional_doc_follow_up,fields,client_name}'      AS fields_client_name,
     doc #>> '{fields,additional_doc_follow_up,fields,place_id}'         AS fields_place_id,
     doc #>> '{fields,additional_doc_follow_up,fields,place_name}'       AS fields_place_name,
     doc #>> '{fields,additional_doc_follow_up,fields,vht_name}'         AS fields_vht_name,
     doc #>> '{fields,additional_doc_follow_up,fields,vht_phone}'        AS fields_vht_phone,
     doc #>> '{fields,additional_doc_follow_up,fields,completed_referral}'  AS completed_referral,
     doc #>> '{fields,additional_doc_follow_up,fields,still_has_danger_signs}'  AS still_has_danger_signs,
    CURRENT_TIMESTAMP AS last_refresh_date
    
FROM dwh.cht_data AS couchdb
WHERE (doc ->> 'form') = 'newborn_danger_sign_follow_up'
  AND is_current
WITH DATA;

CREATE INDEX newborn_danger_sign_follow_up_reported_idx
    ON cht.mv_newborn_danger_sign_follow_up USING btree (reported);
