CREATE MATERIALIZED VIEW cht.mv_pnc_baby_follow_up
TABLESPACE ts_report
AS
SELECT
      doc ->> '_id'                                                AS uuid,
      doc ->> '_rev'                                               AS rev,
      doc ->> 'form'                                               AS form,
      to_timestamp(NULLIF(doc ->> 'reported_date','')::bigint / 1000.0) AS reported,
      doc ->> 'from'                                               AS submitter,
      doc ->> 'content_type'                                       AS top_content_type,
      to_timestamp(NULLIF(doc #>> '{form_version,time}','')::bigint / 1000.0) AS form_version_time,
      doc #>> '{form_version,sha256}'                              AS form_version_sha256,
      (doc -> 'hidden_fields')::text                               AS hidden_fields_json,
     doc #>> '{fields,inputs,source}'                                    AS source,
     doc #>> '{fields,inputs,source_id}'                                 AS source_id,
     doc #>> '{fields,inputs,latest_pnc_visit}'                          AS latest_pnc_visit,
     doc #>> '{fields,inputs,user,contact_id}'                           AS contact_id,
     doc #>> '{fields,inputs,user,facility_id}'                          AS facility_id,
     doc #>> '{fields,inputs,contact,_id}'                               AS _id,
     doc #>> '{fields,inputs,contact,name}'                              AS name,
     doc #>> '{fields,inputs,contact,date_of_birth}'                     AS date_of_birth,
     doc #>> '{fields,inputs,contact,sex}'                               AS sex,
     doc #>> '{fields,inputs,contact,parent,_id}'                        AS parent__id,
     doc #>> '{fields,inputs,contact,parent,name}'                       AS parent_name,
     doc #>> '{fields,inputs,contact,parent,parent,_id}'                 AS parent_parent__id,
     doc #>> '{fields,inputs,contact,parent,parent,name}'                AS parent_parent_name,
     doc #>> '{fields,inputs,contact,parent,parent,village}'             AS village,
     doc #>> '{fields,inputs,contact,parent,parent,contact,_id}'         AS contact__id,
     doc #>> '{fields,inputs,contact,parent,parent,contact,name}'        AS contact_name,
     doc #>> '{fields,inputs,contact,parent,parent,contact,phone}'       AS phone,
     doc #>> '{fields,app_id}'                                           AS app_id,
     doc #>> '{fields,patient_age_in_years}'                             AS patient_age_in_years,
     doc #>> '{fields,patient_age_in_months}'                            AS patient_age_in_months,
     doc #>> '{fields,patient_age_in_days}'                              AS patient_age_in_days,
     doc #>> '{fields,patient_age_display}'                              AS patient_age_display,
     doc #>> '{fields,patient_id}'                                       AS patient_id,
     doc #>> '{fields,patient_name}'                                     AS patient_name,
     doc #>> '{fields,patient_name_with_s}'                              AS patient_name_with_s,
     doc #>> '{fields,patient_gender}'                                   AS patient_gender,
     doc #>> '{fields,has_danger_signs}'                                 AS has_danger_signs,
     doc #>> '{fields,pnc_visit_label}'                                  AS pnc_visit_label,
     doc #>> '{fields,chw_name}'                                         AS chw_name,
     doc #>> '{fields,chw_phone}'                                        AS chw_phone,
     doc #>> '{fields,chw_village}'                                      AS chw_village,
     doc #>> '{fields,group_baby_condition,baby_condition}'              AS baby_condition,
     doc #>> '{fields,group_baby_condition,death_date}'                  AS death_date,
     doc #>> '{fields,group_baby_condition,breastfeeding_exclusively}'   AS breastfeeding_exclusively,
     doc #>> '{fields,group_baby_condition,breastfeeding_within_1hour_delivery}'  AS breastfeeding_within_1hour_delivery,
     doc #>> '{fields,group_baby_condition,child_has_chest_in_drawing}'  AS child_has_chest_in_drawing,
     doc #>> '{fields,group_baby_condition,child_has_convulsions}'       AS child_has_convulsions,
     doc #>> '{fields,group_baby_condition,child_vomiting_everything}'   AS child_vomiting_everything,
     doc #>> '{fields,group_baby_condition,child_unconscious}'           AS child_unconscious,
     doc #>> '{fields,group_baby_condition,child_has_infected_umbilical_cord}'  AS child_has_infected_umbilical_cord,
     doc #>> '{fields,group_baby_condition,child_has_difficulty_feeding}'  AS child_has_difficulty_feeding,
     doc #>> '{fields,group_baby_condition,child_has_body_stiffness}'    AS child_has_body_stiffness,
     doc #>> '{fields,group_baby_condition,child_has_fever}'             AS child_has_fever,
     doc #>> '{fields,group_baby_condition,child_has_yellow_skin}'       AS child_has_yellow_skin,
     doc #>> '{fields,group_baby_condition,referred_to_facility}'        AS referred_to_facility,
     doc #>> '{fields,group_pnc_visit_details,has_attended_pnc}'         AS has_attended_pnc,
     doc #>> '{fields,group_pnc_visit_details,patient_age_1_day_older}'  AS patient_age_1_day_older,
     doc #>> '{fields,group_pnc_visit_details,pnc_visit}'                AS pnc_visit,
     doc #>> '{fields,group_pnc_visit_details,pnc_visit_date}'           AS pnc_visit_date,
     doc #>> '{fields,group_missed_pnc,reason_missed_pnc}'               AS reason_missed_pnc,
     doc #>> '{fields,group_missed_pnc,other_missed_pnc}'                AS other_missed_pnc,
     doc #>> '{fields,group_missed_pnc,has_agreed_to_pnc_visit}'         AS has_agreed_to_pnc_visit,
     doc #>> '{fields,group_missed_pnc,date_agreed_to_pnc_visit}'        AS date_agreed_to_pnc_visit,
     doc #>> '{fields,additional_doc,type}'                              AS type,
     doc #>> '{fields,additional_doc,content_type}'                      AS content_type,
     doc #>> '{fields,additional_doc,form}'                              AS form_field,
     doc #>> '{fields,additional_doc,contact,_id}'                       AS additional_doc_contact__id,
     doc #>> '{fields,additional_doc,parent,_id}'                        AS additional_doc_parent__id,
     doc #>> '{fields,additional_doc,fields,inputs,source}'              AS inputs_source,
     doc #>> '{fields,additional_doc,fields,inputs,source_id}'           AS inputs_source_id,
     doc #>> '{fields,additional_doc,fields,created_by_doc}'             AS created_by_doc,
     doc #>> '{fields,additional_doc,fields,client_id}'                  AS client_id,
     doc #>> '{fields,additional_doc,fields,client_uuid}'                AS client_uuid,
     doc #>> '{fields,additional_doc,fields,client_name}'                AS client_name,
     doc #>> '{fields,additional_doc,fields,place_id}'                   AS place_id,
     doc #>> '{fields,additional_doc,fields,place_name}'                 AS place_name,
     doc #>> '{fields,additional_doc,fields,vht_name}'                   AS vht_name,
     doc #>> '{fields,additional_doc,fields,vht_phone}'                  AS vht_phone,
     doc #>> '{fields,additional_doc,fields,follow_up_date}'             AS follow_up_date,
     doc #>> '{fields,additional_doc,fields,client_age_in_years}'        AS client_age_in_years,
     doc #>> '{fields,additional_doc,fields,client_age_in_months}'       AS client_age_in_months,
     doc #>> '{fields,additional_doc,fields,client_age_in_days}'         AS client_age_in_days,
     doc #>> '{fields,additional_doc,fields,client_age_display}'         AS client_age_display,
     doc #>> '{fields,additional_doc,fields,client_sex}'                 AS client_sex,
     doc #>> '{fields,additional_doc,fields,danger_signs,_child_has_chest_in_drawing}'  AS _child_has_chest_in_drawing,
     doc #>> '{fields,additional_doc,fields,danger_signs,_child_has_convulsions}'  AS _child_has_convulsions,
     doc #>> '{fields,additional_doc,fields,danger_signs,_child_vomiting_everything}'  AS _child_vomiting_everything,
     doc #>> '{fields,additional_doc,fields,danger_signs,_child_unconscious}'  AS _child_unconscious,
     doc #>> '{fields,additional_doc,fields,danger_signs,_child_has_infected_umbilical_cord}'  AS _child_has_infected_umbilical_cord,
     doc #>> '{fields,additional_doc,fields,danger_signs,_child_has_difficulty_feeding}'  AS _child_has_difficulty_feeding,
     doc #>> '{fields,additional_doc,fields,danger_signs,_child_has_body_stiffness}'  AS _child_has_body_stiffness,
     doc #>> '{fields,additional_doc,fields,danger_signs,_child_has_fever}'  AS _child_has_fever,
     doc #>> '{fields,additional_doc,fields,danger_signs,_child_has_yellow_skin}'  AS _child_has_yellow_skin,
    CURRENT_TIMESTAMP AS last_refresh_date
FROM dwh.cht_data AS couchdb
WHERE (doc ->> 'form') = 'pnc_baby_follow_up'
  AND is_current
WITH DATA;

CREATE INDEX pnc_baby_follow_up_reported_idx
    ON cht.mv_pnc_baby_follow_up USING btree (reported);
